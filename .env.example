# Formulaire de contact — livraison des emails (facultatif)
# Sans ces variables, le formulaire ACCEPTE les messages mais ne les envoie pas
# (le front affiche la confirmation + propose un repli mailto).
#
# Pour activer l'envoi : crée un compte gratuit sur https://resend.com,
# génère une clé API, et renseigne :

# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# CONTACT_TO=flo.gouesse@gmail.com
# CONTACT_FROM=Portfolio <onboarding@resend.dev>
